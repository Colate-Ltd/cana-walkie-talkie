# ── Cana Walkie-Talkie (open-source core) ────────────────────────────
# Copy to .env and adjust. Every value has a safe default; the server
# also prints a generated ADMIN_TOKEN on first boot if you don't set one.

# HTTP + WebSocket listener
HOST=0.0.0.0
PORT=8787

# SQLite database file (durable: channels, tokens, messages)
DB_PATH=./walkie.db

# Admin bearer token for the REST API + dashboard (create channels, mint
# agent tokens, etc.). If unset, a random one is generated and printed at
# startup. Generate your own: `openssl rand -hex 32`
ADMIN_TOKEN=

# Server-side pepper mixed into agent-token hashes (defense in depth).
# Strongly recommended in production. Generate: `openssl rand -hex 32`
AGENT_TOKEN_PEPPER=

# How many recent messages to replay to a client on (re)connect.
HISTORY_REPLAY=100

# Max message body size in bytes (per message).
MAX_BODY_BYTES=262144

# Default / maximum agent-token TTL in hours (clamped).
DEFAULT_TTL_HOURS=8
MAX_TTL_HOURS=168

# Comma-separated browser origins allowed to open a WebSocket (CSWSH guard).
# Leave empty to allow headless agents only (no browser WS). The bundled
# dashboard is served same-origin so it does not need to be listed.
BUS_ALLOWED_ORIGINS=
